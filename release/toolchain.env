# The pinned release toolchain (docs/release.md). Read by release/build.sh and
# the phase3.reproducible and phase3.install checks; one KEY=value per line.
#
# Builder: the official Rust image on Alpine, by its multi-platform index
# digest. Rust 1.96.0 (the CI toolchain), musl host, so the relay links
# statically. Changing it changes every release hash.
BUILDER_IMAGE=rust:1.96.0-alpine@sha256:f87aa870663e2b57ec8c69de82c7eedf7383bee987eef7612c0359635eaadb41
# BuildKit that builds the relay image, by digest: its exporter decides the
# image bytes, so the image digest is reproducible only with the same one.
# Images are built without provenance or SBOM attestations, offline, with
# SOURCE_DATE_EPOCH and rewritten timestamps.
BUILDKIT_IMAGE=moby/buildkit:v0.25.2@sha256:0f63d66f8d2de0bd16438284831a3e9ee6ca7cd57b6eb3ed6e38a7a456590fa7
# Linux platforms a release builds, each natively in the builder for it.
PLATFORMS=linux/amd64 linux/arm64
# Packages released as static binaries.
PACKAGES=mousse-relay
